# Copy to .env and fill in. Never commit .env.

# Neon, pooled connection string (host contains -pooler): used by the app.
DATABASE_URL=
# Neon, direct (non-pooled) connection string: used only by migrations (pnpm db:migrate).
DATABASE_URL_UNPOOLED=

# The single administrator (Nuxt runtimeConfig: adminLogin, adminPassword). Without both
# values the admin sign-in is disabled. Nuxt casts values that look like numbers or JSON:
# a password such as 4848e0 must be written with the quotes inside the value: '"4848e0"'.
NUXT_ADMIN_LOGIN=
NUXT_ADMIN_PASSWORD=

# Encrypts the session cookie, at least 32 characters.
# nuxt-auth-utils generates one into .env on the first `pnpm dev`; production needs its own.
NUXT_SESSION_PASSWORD=

# Vercel Blob (private store with the painted thumbnails of the gallery). Connect the store to the
# project in the Vercel dashboard (Storage > Blob > Connect Project): it provides BLOB_STORE_ID, and on
# Vercel the server authenticates with the OIDC token of the deployment. Locally `vercel env pull`
# brings both; without a store the thumbnails are kept in memory (development only).
BLOB_STORE_ID=
